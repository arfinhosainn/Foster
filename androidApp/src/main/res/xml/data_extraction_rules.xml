<?xml version="1.0" encoding="utf-8"?>
<!-- Data-extraction rules for Android 12+ (cloud backup + device transfer).
     Excludes app-private local state: DataStore preferences (onboarding
     draft, theme, swipe hints, paywall state, notification plan) and all
     SharedPreferences (including the Supabase auth session store).
     Rationale: keep account data out of cloud backups/transfers — see
     COMPLIANCE_TODO item 7 and PRIVACY_POLICY.md §10. Users re-authenticate
     after a restore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
