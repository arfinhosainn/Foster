<resources>
    <!-- Android 12+ system splash screen, backported to API 24 via
         androidx.core:core-splashscreen (see libs.versions.toml). -->
    <style name="Theme.Nekko.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- Full logo (green circle + foreground) baked into one drawable;
             see drawable/splash_icon.xml. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Nekko.Main</item>
    </style>

    <!-- Runtime theme once the splash is dismissed; matches the previous
         android:style/Theme.Material.Light.NoActionBar the manifest used. -->
    <style name="Theme.Nekko.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>