// Local secrets are injected from the gitignored Secrets.xcconfig next to this
// file (#include? = optional, so fresh clones build and fail at app startup
// with instructions instead of breaking the Xcode project).
// GOTCHA: xcconfig treats // as a comment — escape URLs as https:$()//…
#include? Secrets.xcconfig

TEAM_ID=

PRODUCT_NAME=Foster
PRODUCT_BUNDLE_IDENTIFIER=app.usefoster.Foster$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0.0