// TEMPLATE — copy to Secrets.xcconfig (same folder) and fill in. That file is
// gitignored and must NEVER be committed (this repo is public).
//
// GOTCHA: xcconfig treats // as a comment, so a literal URL would silently
// truncate at the slashes. Escape them as https:$()//…
SUPABASE_URL = https:$()//YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_WEB_CLIENT_ID = 000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
REVENUECAT_IOS_KEY = appl_xxxxxxxxxxxxxxxx